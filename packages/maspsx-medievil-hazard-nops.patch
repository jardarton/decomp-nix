+    def _pad_mflo_load(self, emitted: List[str]) -> List[str]:
+        # medievil patch: an mflo/mfhi, one load, then mult/div/rem. A load
+        # that the assembler keeps as one instruction (register base,
+        # %lo(), %gp_rel()) leaves the mult/div only two instructions after
+        # the mflo/mfhi, so retail ASPSX adds a nop after it, unless the
+        # load-delay check already did.
+        real = [
+            x
+            for x in emitted
+            if x.strip()
+            and not x.lstrip().startswith("#")
+            and not x.lstrip().startswith(".")
+        ]
+        if len(real) != 1:
+            # expanded through $at (or already padded)
+            return []
+        load = strip_comments(real[0]).strip()
+        if "(" not in load:
+            # a bare symbol: the assembler expands it to lui + load
+            return []
+        return ["nop  # DEBUG: mflo/mfhi with mult/div/rem and 1 load"]
+
