diff --git a/tests/test_mflo.py b/tests/test_mflo.py
index 287b06b..9e7ef3f 100644
--- a/tests/test_mflo.py
+++ b/tests/test_mflo.py
@@ -307,3 +307,95 @@ class TestMflo(unittest.TestCase):
 
         clean_lines = strip_comments(res)
         self.assertEqual(expected_lines, clean_lines)
+
+
+class TestMfloMedievilPatch(unittest.TestCase):
+    """Local patch for MediEvil (decomp-nix); not upstream maspsx."""
+
+    def test_mflo_jump_before_label(self):
+        # main:func_8003B5A8: the nop goes in the j delay slot, before the
+        # labels that a branch elsewhere targets
+        lines = [
+            "	mflo	$4",
+            "	j	$L28",
+            "$L29:",
+            "$L36:",
+            "	mult	$4,$2",
+        ]
+        expected_lines = [
+            "mflo\t$4",
+            "j\t$L28",
+            "nop",
+            "$L29:",
+            "$L36:",
+            "mult\t$4,$2",
+        ]
+        mp = MaspsxProcessor(lines)
+        res = mp.process_lines()
+        self.assertEqual(expected_lines, strip_comments(res))
+
+    def test_mflo_gp_load_before_mult(self):
+        # main:func_80041B5C: mflo; lw (gp-relative); nop; div
+        lines = [
+            "	.comm	D_800EDB3C,4",
+            "	mflo	$18",
+            "	lw	$4,D_800EDB3C",
+            "	mult	$3,$2",
+        ]
+        expected_lines = [
+            "mflo\t$18",
+            "lw\t$4,%gp_rel(D_800EDB3C)($gp)",
+            "nop",
+            "mult\t$3,$2",
+        ]
+        mp = MaspsxProcessor(lines, sdata_limit=8)
+        res = mp.process_lines()
+        self.assertEqual(expected_lines, strip_comments(res)[:4])
+
+    def test_mflo_register_load_before_mult(self):
+        lines = [
+            "	mflo	$18",
+            "	lw	$4,8($5)",
+            "	mult	$3,$2",
+        ]
+        expected_lines = [
+            "mflo\t$18",
+            "lw\t$4,8($5)",
+            "nop",
+            "mult\t$3,$2",
+        ]
+        mp = MaspsxProcessor(lines)
+        res = mp.process_lines()
+        self.assertEqual(expected_lines, strip_comments(res))
+
+    def test_mflo_load_delay_nop_not_doubled(self):
+        lines = [
+            "	mflo	$18",
+            "	lw	$2,8($5)",
+            "	mult	$3,$2",
+        ]
+        expected_lines = [
+            "mflo\t$18",
+            "lw\t$2,8($5)",
+            "nop",
+            "mult\t$3,$2",
+        ]
+        mp = MaspsxProcessor(lines)
+        res = mp.process_lines()
+        self.assertEqual(expected_lines, strip_comments(res))
+
+    def test_mflo_symbol_load_needs_no_nop(self):
+        # lui + lw already separate the mflo from the mult
+        lines = [
+            "	mflo	$18",
+            "	lw	$4,D_80001000",
+            "	mult	$3,$2",
+        ]
+        expected_lines = [
+            "mflo\t$18",
+            "lw\t$4,D_80001000",
+            "mult\t$3,$2",
+        ]
+        mp = MaspsxProcessor(lines)
+        res = mp.process_lines()
+        self.assertEqual(expected_lines, strip_comments(res))
